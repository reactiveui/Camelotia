<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>Camelotia.Presentation.Wpf.Program</StartupObject>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <IncludePackageReferencesDuringMarkupCompilation>true</IncludePackageReferencesDuringMarkupCompilation>
    <UseWpf>true</UseWpf>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />
    <PackageReference Include="MaterialDesignColors" Version="5.4.0" />
    <PackageReference Include="MaterialDesignThemes" Version="5.4.0" />
    <PackageReference Include="MaterialDesignThemes.MahApps" Version="5.4.0" />
    <PackageReference Include="ReactiveUI.WPF.Reactive" Version="28.0.0" />
    <PackageReference Include="Akavache.Sqlite3.Reactive" Version="13.0.0" />
    <PackageReference Include="Akavache.SystemTextJson.Reactive" Version="13.0.0" />
    <PackageReference Include="ReactiveMarbles.ObservableEvents.SourceGenerator" Version="1.3.1" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Camelotia.Presentation\Camelotia.Presentation.csproj" />
    <ProjectReference Include="..\Camelotia.Services\Camelotia.Services.csproj" />
  </ItemGroup>
</Project>

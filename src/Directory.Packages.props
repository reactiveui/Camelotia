<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- StyleSharp, PerformanceSharp and SecuritySharp ship together and always share a version. -->
    <RoslynCommonAnalyzersVersion>5.2.0</RoslynCommonAnalyzersVersion>
    <ReactiveUIVersion>28.0.0</ReactiveUIVersion>
    <AkavacheVersion>14.0.0</AkavacheVersion>
    <MaterialDesignVersion>5.4.0</MaterialDesignVersion>
    <AvaloniaVersion>12.2.0</AvaloniaVersion>
    <RefitVersion>17.0.0</RefitVersion>
  </PropertyGroup>

  <Choose>
    <When Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">
      <PropertyGroup>
        <MicrosoftExtensionsVersion>11.0.0</MicrosoftExtensionsVersion>
      </PropertyGroup>
    </When>
    <Otherwise>
      <PropertyGroup>
        <MicrosoftExtensionsVersion>10.0.15</MicrosoftExtensionsVersion>
      </PropertyGroup>
    </Otherwise>
  </Choose>

  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftExtensionsVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="$(MicrosoftExtensionsVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="StyleSharp.Analyzers" Version="$(RoslynCommonAnalyzersVersion)" />
    <PackageVersion Include="PerformanceSharp.Analyzers" Version="$(RoslynCommonAnalyzersVersion)" />
    <PackageVersion Include="SecuritySharp.Analyzers" Version="$(RoslynCommonAnalyzersVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="ReactiveUI" Version="$(ReactiveUIVersion)" />
    <PackageVersion Include="ReactiveUI.WPF" Version="$(ReactiveUIVersion)" />
    <PackageVersion Include="ReactiveUI.Avalonia" Version="12.1.9" />
    <PackageVersion Include="ReactiveUI.Validation" Version="9.0.0" />
    <PackageVersion Include="ReactiveUI.SourceGenerators" Version="7.1.0" />
    <PackageVersion Include="ReactiveUI.Primitives.ObservableEvents" Version="10.2.3" />
    <PackageVersion Include="Akavache" Version="$(AkavacheVersion)" />
    <PackageVersion Include="Akavache.Sqlite3" Version="$(AkavacheVersion)" />
    <PackageVersion Include="Akavache.SystemTextJson" Version="$(AkavacheVersion)" />
    <PackageVersion Include="DynamicData" Version="9.5.0" />
    <PackageVersion Include="System.Reactive" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="MahApps.Metro" Version="2.4.11" />
    <PackageVersion Include="MaterialDesignColors" Version="$(MaterialDesignVersion)" />
    <PackageVersion Include="MaterialDesignThemes" Version="$(MaterialDesignVersion)" />
    <PackageVersion Include="MaterialDesignThemes.MahApps" Version="$(MaterialDesignVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="FluentFTP" Version="55.1.0" />
    <PackageVersion Include="Google.Apis.Drive.v3" Version="1.78.0.4327" />
    <PackageVersion Include="Octokit" Version="14.0.0" />
    <PackageVersion Include="Refit" Version="$(RefitVersion)" />
    <PackageVersion Include="Refit.HttpClientFactory" Version="$(RefitVersion)" />
    <PackageVersion Include="Refit.Testing" Version="$(RefitVersion)" />
    <PackageVersion Include="ssh.net" Version="2026.0.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="TUnit" Version="1.87.12" />
  </ItemGroup>
</Project>
